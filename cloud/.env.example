# Ejemplo didáctico. NO uses estas claves para la nube pública.
MATICK_HOST=127.0.0.1
MATICK_PORT=8787
MATICK_DB_PATH=./matick-events.db
# Variable JSON: asignarla desde el administrador de secretos del proveedor.
MATICK_TOKENS_JSON={"matick-studio-lm":"CAMBIAR_TOKEN_STUDIO","matick-chat":"CAMBIAR_TOKEN_CHAT"}

# Proveedor opcional de chat. Sin descargar modelos ni SDKs pesados.
# En otro equipo/servidor, usar HTTPS y una clave real por secreto.
# Un servidor OpenAI-compatible local puede utilizar http://127.0.0.1:1234/v1
MATICK_MODEL_BASE_URL=
MATICK_MODEL_ID=
MATICK_MODEL_API_KEY=
