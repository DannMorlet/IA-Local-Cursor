# Ejemplo didáctico. NO uses estas claves para la nube pública.
MATICK_HOST=127.0.0.1
MATICK_PORT=8787
MATICK_DB_PATH=./matick-events.db
# Variable JSON: asignarla desde el administrador de secretos del proveedor.
MATICK_TOKENS_JSON={"matick-studio-lm":"CAMBIAR_TOKEN_STUDIO","matick-chat":"CAMBIAR_TOKEN_CHAT"}

# Proveedor opcional de chat. Sin descargar modelos ni SDKs pesados.
# En otro equipo/servidor, usar HTTPS y una clave real por secreto.
# Un servidor OpenAI-compatible local puede utilizar http://127.0.0.1:1234/v1
MATICK_MODEL_BASE_URL=
MATICK_MODEL_ID=
MATICK_MODEL_API_KEY=

# REST v1 local (LM Studio 0.4+, opcional; NO es el motor propio de Matick)
MATICK_REST_V1_URL=
MATICK_REST_V1_TOKEN=
# Peligro de espacio: descargas de modelos grandes desactivadas por defecto
MATICK_ALLOW_MODEL_DOWNLOADS=0

# Motor local de Matick: independiente de LM Studio, usa llama.cpp (GGUF).
# En auto se activa al encontrar llama-server.exe y si REST v1 no está configurado.
# Para forzar motor local y ver error explícito si faltan componentes: local.
MATICK_INFERENCE_BACKEND=auto
MATICK_HOME=C:\IA\Matick Studio LM
MATICK_LOCAL_MODELS_DIR=C:\IA\Matick Studio LM\models
MATICK_LLAMA_SERVER=C:\IA\Matick Studio LM\engine\llama-server.exe
# El motor local solo escucha en loopback, con token aleatorio.
# No incluyas archivos GGUF ni binarios externos en GitHub.
